+// snitchmd: extracts a page's main content as Markdown with rs-trafilatura
+// for `--dump markdown`.
+
+use rs_trafilatura::{extract_with_options, Options};
+use std::os::raw::c_uchar;
+
+/// Page to extract from. `url` resolves relative links and may be empty.
+#[repr(C)]
+pub struct TrafilaturaInput {
+    pub html_ptr: *const c_uchar,
+    pub html_len: usize,
+    pub url_ptr: *const c_uchar,
+    pub url_len: usize,
+    pub include_images: bool,
+    pub favor_precision: bool,
+    pub favor_recall: bool,
+}
+
+/// Bytes owned by Rust; a null `ptr` means absent.
+#[repr(C)]
+pub struct TrafilaturaBytes {
+    pub ptr: *mut c_uchar,
+    pub len: usize,
+}
+
+/// Extraction returned to Zig; freed with `trafilatura_free`.
+#[repr(C)]
+pub struct TrafilaturaOutput {
+    /// Null when no main content was found or extraction failed.
+    pub markdown: TrafilaturaBytes,
+    pub title: TrafilaturaBytes,
+    pub page_type: TrafilaturaBytes,
+    /// rs-trafilatura's extraction quality, 0.0 - 1.0.
+    pub quality: f64,
+}
+
+/// Extracts the main content as Markdown. Failures go to stderr and return a
+/// null `markdown`.
+#[no_mangle]
+pub extern "C" fn trafilatura_markdown(input: TrafilaturaInput) -> TrafilaturaOutput {
+    let empty = TrafilaturaOutput { markdown: none(), title: none(), page_type: none(), quality: 0.0 };
+
+    // Empty HTML input.
+    let Some(html) = read_bytes(input.html_ptr, input.html_len) else {
+        return empty;
+    };
+
+    let html = String::from_utf8_lossy(html);
+    let url = read_bytes(input.url_ptr, input.url_len).map(|b| String::from_utf8_lossy(b).into_owned());
+
+    // Matches the options snitchmd v1 passed to rs-trafilatura with --markdown.
+    let options = Options {
+        url,
+        output_markdown: true,
+        include_tables: true,
+        include_links: true,
+        include_formatting: true,
+        include_images: input.include_images,
+        favor_precision: input.favor_precision,
+        favor_recall: input.favor_recall,
+        ..Options::default()
+    };
+
+    let result = match extract_with_options(&html, &options) {
+        Ok(r) => r,
+        Err(e) => {
+            eprintln!("trafilatura failed for {:?}: {e}", options.url);
+            return empty;
+        }
+    };
+
+    let markdown = result.content_markdown.unwrap_or(result.content_text);
+    let markdown = markdown.trim();
+
+    // The page has no main content.
+    if markdown.is_empty() {
+        return empty;
+    }
+
+    TrafilaturaOutput {
+        markdown: give(markdown),
+        title: result.metadata.title.as_deref().map_or_else(none, give),
+        page_type: result.metadata.page_type.as_deref().map_or_else(none, give),
+        quality: result.extraction_quality,
+    }
+}
+
+/// Frees everything in an output of `trafilatura_markdown`.
+#[no_mangle]
+pub extern "C" fn trafilatura_free(out: TrafilaturaOutput) {
+    for bytes in [out.markdown, out.title, out.page_type] {
+        if bytes.ptr.is_null() {
+            continue;
+        }
+        unsafe {
+            drop(Box::from_raw(std::slice::from_raw_parts_mut(bytes.ptr, bytes.len)));
+        }
+    }
+}
+
+fn none() -> TrafilaturaBytes {
+    TrafilaturaBytes { ptr: std::ptr::null_mut(), len: 0 }
+}
+
+/// Moves a copy of `s` to Zig; trafilatura_free rebuilds the Box and frees it.
+fn give(s: &str) -> TrafilaturaBytes {
+    let mut boxed = s.as_bytes().to_vec().into_boxed_slice();
+    let out = TrafilaturaBytes { ptr: boxed.as_mut_ptr(), len: boxed.len() };
+    std::mem::forget(boxed);
+    out
+}
+
+/// Turns a pointer and length from Zig into a byte slice; None when the length is 0.
+/// Zig never passes a null pointer.
+fn read_bytes<'a>(ptr: *const c_uchar, len: usize) -> Option<&'a [u8]> {
+    (len > 0).then(|| unsafe { std::slice::from_raw_parts(ptr, len) })
+}
diff --git a/src/snitchmd.zig b/src/snitchmd.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5a5b7d909de6221f4c10ccccec3847f8005bf033
--- /dev/null
+++ b/src/snitchmd.zig
@@ -0,0 +1,199 @@
+// snitchmd: what `snitchmd URL` adds around a Markdown dump of one URL —
+// the result cache, the stderr summary, `--json` in the snitchmd v1 format,
+// `--html-output` and exit code 2 for a page without main content.
+
+const std = @import("std");
+const lp = @import("lightpanda");
+
+const log = lp.log;
+const Config = lp.Config;
+const Result = lp.trafilatura.Result;
+const LimitedWriter = lp.LimitedWriter;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+const Fetch = @FieldType(Config.Mode, "fetch");
+
+/// Exit code for a page without main content, as in snitchmd v1.
+pub const exit_empty = 2;
+
+/// Below this extraction quality the result is printed but not cached: a login
+/// wall or an error page served with status 200 scores this low.
+const min_cache_quality = 0.5;
+
+/// Output written for one URL; also the cache file format.
+const Payload = struct {
+    url: []const u8,
+    final_url: []const u8,
+    title: ?[]const u8,
+    page_title: ?[]const u8,
+    page_type: ?[]const u8,
+    quality: ?f64,
+    chars: usize,
+    markdown: []const u8,
+};
+
+/// A Markdown dump of one URL gets the snitchmd treatment; anything else is
+/// plain Lightpanda.
+pub fn applies(opts: Fetch) bool {
+    return opts.dump == .markdown and opts.url.items.len == 1 and !opts.markdown_alternate;
+}
+
+/// Prints the cached result and returns true, or returns false on a miss.
+/// `--html-output` needs the HTML, which is not cached, so it always misses.
+pub fn printCached(arena: std.mem.Allocator, opts: Fetch, proc_args: std.process.Args) !bool {
+    if (opts.no_cache or opts.html_output != null) return false;
+    const path = try cacheFile(arena, proc_args) orelse return false;
+    const data = std.Io.Dir.cwd().readFileAlloc(lp.io, path, arena, .unlimited) catch return false;
+    const payload = std.json.parseFromSliceLeaky(Payload, arena, data, .{ .ignore_unknown_fields = true }) catch {
+        log.warn(.app, "snitchmd cache unreadable", .{ .path = path });
+        return false;
+    };
+    try print(arena, payload, opts, .cached);
+    return true;
+}
+
+/// Saves `--html-output`, caches the result and prints it.
+pub fn finish(arena: std.mem.Allocator, result: *const Result, opts: Fetch, proc_args: std.process.Args) !void {
+    const payload: Payload = .{
+        .url = opts.url.items[0],
+        .final_url = result.final_url,
+        .title = result.title orelse result.page_title,
+        .page_title = result.page_title,
+        .page_type = result.page_type,
+        .quality = result.quality,
+        .chars = charCount(result.markdown),
+        .markdown = result.markdown,
+    };
+
+    if (opts.html_output) |path| {
+        try std.Io.Dir.cwd().writeFile(lp.io, .{ .sub_path = path, .data = result.html });
+    }
+
+    // The cache is best-effort. Served Markdown has no quality and is cached.
+    const cacheable = (payload.quality orelse 1) >= min_cache_quality;
+    if (cacheable) {
+        cachePut(arena, payload, proc_args) catch |err| {
+            log.warn(.app, "snitchmd cache write failed", .{ .err = err });
+        };
+    }
+
+    try print(arena, payload, opts, if (cacheable) .fresh else .not_cached);
+}
+
+/// Where the printed result stands with the cache, for the stderr summary.
+const CacheState = enum { fresh, cached, not_cached };
+
+fn print(arena: std.mem.Allocator, payload: Payload, opts: Fetch, cache: CacheState) !void {
+    const shown = try truncate(arena, payload.markdown, opts.dump_max_bytes);
+    const truncated = shown.len != payload.markdown.len;
+
+    var out_buf: [4096]u8 = undefined;
+    var out = std.Io.File.stdout().writerStreaming(lp.io, &out_buf);
+    const stdout = &out.interface;
+    if (opts.json) {
+        var shown_payload = payload;
+        shown_payload.markdown = shown;
+        shown_payload.chars = charCount(shown);
+        var jws: std.json.Stringify = .{ .writer = stdout, .options = .{ .whitespace = .indent_2 } };
+        try jws.beginObject();
+        inline for (@typeInfo(Payload).@"struct".field_names) |name| {
+            try jws.objectField(name);
+            try jws.write(@field(shown_payload, name));
+        }
+        if (truncated) {
+            try jws.objectField("full_chars");
+            try jws.write(payload.chars);
+            try jws.objectField("truncated");
+            try jws.write(true);
+        }
+        try jws.endObject();
+        try stdout.writeByte('\n');
+    } else {
+        try stdout.writeAll(shown);
+        try stdout.writeByte('\n');
+    }
+    try stdout.flush();
+
+    var err_buf: [1024]u8 = undefined;
+    var err_out = std.Io.File.stderr().writerStreaming(lp.io, &err_buf);
+    const stderr = &err_out.interface;
+    try stderr.print("snitchmd: title={f} quality=", .{std.json.fmt(payload.title, .{})});
+    if (payload.quality) |q| try stderr.print("{d:.2}", .{q}) else try stderr.writeAll("null");
+    try stderr.print(" chars={d}", .{charCount(shown)});
+    if (truncated) try stderr.print(" truncated_from={d}", .{payload.chars});
+    switch (cache) {
+        .fresh => {},
+        .cached => try stderr.writeAll(" (cached)"),
+        .not_cached => try stderr.writeAll(" (not cached: low quality)"),
+    }
+    try stderr.writeByte('\n');
+    try stderr.flush();
+}
+
+/// Cuts `markdown` to `max_bytes` at a UTF-8 boundary and appends the marker
+/// the other dumps use.
+fn truncate(arena: std.mem.Allocator, markdown: []const u8, max_bytes: ?u32) ![]const u8 {
+    const max = max_bytes orelse return markdown;
+    if (markdown.len <= max) return markdown;
+    var end: usize = max;
+    while (end > 0 and markdown[end] & 0xC0 == 0x80) end -= 1;
+    return std.mem.concat(arena, u8, &.{ markdown[0..end], std.mem.trimEnd(u8, LimitedWriter.truncation_marker, "\n") });
+}
+
+/// Characters, not bytes, as snitchmd v1 reported them.
+fn charCount(s: []const u8) usize {
+    return std.unicode.utf8CountCodepoints(s) catch s.len;
+}
+
+fn cachePut(arena: std.mem.Allocator, payload: Payload, proc_args: std.process.Args) !void {
+    const path = try cacheFile(arena, proc_args) orelse return;
+    try std.Io.Dir.cwd().createDirPath(lp.io, std.fs.path.dirname(path).?);
+    var file = try std.Io.Dir.cwd().createFileAtomic(lp.io, path, .{ .replace = true });
+    defer file.deinit(lp.io);
+    var buf: [8192]u8 = undefined;
+    var writer = file.file.writer(lp.io, &buf);
+    try std.json.Stringify.value(payload, .{}, &writer.interface);
+    try writer.end();
+    try file.replace(lp.io);
+}
+
+/// `<cache dir>/<sha256 of the arguments>.json`, or null without a home directory.
+/// Output-only options are left out of the key.
+fn cacheFile(arena: std.mem.Allocator, proc_args: std.process.Args) !?[]const u8 {
+    const dir = try cacheDir(arena) orelse return null;
+
+    var hasher = Sha256.init(.{});
+    hasher.update("snitchmd-cache-1");
+
+    var args = std.process.Args.Iterator.init(proc_args);
+    defer args.deinit();
+    _ = args.skip(); // executable name
+    while (args.next()) |arg| {
+        if (isOneOf(arg, &.{ "--json", "--no-cache" })) continue;
+        if (isOneOf(arg, &.{ "--html-output", "--dump-max-bytes" })) {
+            _ = args.skip();
+            continue;
+        }
+        hasher.update(arg);
+        hasher.update("\x00");
+    }
+
+    var digest: [Sha256.digest_length]u8 = undefined;
+    hasher.final(&digest);
+    const name = try std.fmt.allocPrint(arena, "{s}.json", .{&std.fmt.bytesToHex(digest, .lower)});
+    return try std.fs.path.join(arena, &.{ dir, name });
+}
+
+fn cacheDir(arena: std.mem.Allocator) !?[]const u8 {
+    if (std.c.getenv("SNITCHMD_CACHE_DIR")) |dir| return std.mem.span(dir);
+    if (std.c.getenv("XDG_CACHE_HOME")) |dir| return try std.fs.path.join(arena, &.{ std.mem.span(dir), "snitchmd" });
+    const home = std.c.getenv("HOME") orelse return null;
+    return try std.fs.path.join(arena, &.{ std.mem.span(home), ".cache", "snitchmd" });
+}
+
+fn isOneOf(arg: []const u8, names: []const []const u8) bool {
+    for (names) |name| {
+        if (std.mem.eql(u8, arg, name)) return true;
+    }
+    return false;
+}
