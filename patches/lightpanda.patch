+// snitchmd: extracts a page's main content as Markdown with rs-trafilatura
+// for `--dump main_markdown`.
+
+use rs_trafilatura::{extract_with_options, Options};
+use std::os::raw::c_uchar;
+
+/// Page to extract from. `url` resolves relative links and may be empty.
+#[repr(C)]
+pub struct TrafilaturaInput {
+    pub html_ptr: *const c_uchar,
+    pub html_len: usize,
+    pub url_ptr: *const c_uchar,
+    pub url_len: usize,
+}
+
+/// Markdown returned to Zig; freed with `trafilatura_free`.
+#[repr(C)]
+pub struct TrafilaturaOutput {
+    pub ptr: *mut c_uchar,
+    pub len: usize,
+}
+
+/// Extracts the main content as Markdown. A null `ptr` means no main content
+/// was found or extraction failed (failures go to stderr).
+#[no_mangle]
+pub extern "C" fn trafilatura_markdown(input: TrafilaturaInput) -> TrafilaturaOutput {
+    let empty = TrafilaturaOutput { ptr: std::ptr::null_mut(), len: 0 };
+
+    // Empty HTML input.
+    let Some(html) = read_bytes(input.html_ptr, input.html_len) else {
+        return empty;
+    };
+
+    let html = String::from_utf8_lossy(html);
+    let url = read_bytes(input.url_ptr, input.url_len).map(|b| String::from_utf8_lossy(b).into_owned());
+
+    // Matches the options snitchmd v1 passed to rs-trafilatura with --markdown.
+    let options = Options {
+        url,
+        output_markdown: true,
+        include_tables: true,
+        include_links: true,
+        include_formatting: true,
+        include_images: false,
+        ..Options::default()
+    };
+
+    let markdown = match extract_with_options(&html, &options) {
+        Ok(r) => r.content_markdown.unwrap_or(r.content_text),
+        Err(e) => {
+            eprintln!("trafilatura failed for {:?}: {e}", options.url);
+            return empty;
+        }
+    };
+
+    let markdown = markdown.trim();
+
+    // The page has no main content.
+    if markdown.is_empty() {
+        return empty;
+    }
+
+    let mut boxed = markdown.as_bytes().to_vec().into_boxed_slice();
+    let out = TrafilaturaOutput { ptr: boxed.as_mut_ptr(), len: boxed.len() };
+    // Ownership moves to Zig; trafilatura_free rebuilds the Box and frees it.
+    std::mem::forget(boxed);
+    out
+}
+
+/// Frees Markdown returned by `trafilatura_markdown`. A null output is a no-op.
+#[no_mangle]
+pub extern "C" fn trafilatura_free(out: TrafilaturaOutput) {
+    if out.ptr.is_null() {
+        return;
+    }
+
+    unsafe {
+        drop(Box::from_raw(std::slice::from_raw_parts_mut(out.ptr, out.len)));
+    }
+}
+
+/// Turns a pointer and length from Zig into a byte slice; None when the length is 0.
+/// Zig never passes a null pointer.
+fn read_bytes<'a>(ptr: *const c_uchar, len: usize) -> Option<&'a [u8]> {
+    (len > 0).then(|| unsafe { std::slice::from_raw_parts(ptr, len) })
+}
