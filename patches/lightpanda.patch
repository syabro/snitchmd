diff --git a/src/browser/snitchmd/safari.js b/src/browser/snitchmd/safari.js
new file mode 100644
index 0000000000000000000000000000000000000000..58bd84efe243005f641fff5b06422716aea3fcaf
--- /dev/null
+++ b/src/browser/snitchmd/safari.js
@@ -0,0 +1,9 @@
+// Sets JS navigator properties to match Safari: deletes userAgentData, sets vendor to Apple.
+(function () {
+  delete Navigator.prototype.userAgentData;
+
+  Object.defineProperty(Navigator.prototype, "vendor", {
+    get: function () { return "Apple Computer, Inc."; },
+    configurable: true,
+  });
+})();
diff --git a/src/browser/snitchmd/style-index.js b/src/browser/snitchmd/style-index.js
new file mode 100644
index 0000000000000000000000000000000000000000..31a1539be9187ea313300165a4b43f205731c217
--- /dev/null
+++ b/src/browser/snitchmd/style-index.js
@@ -0,0 +1,18 @@
+// Lightpanda lacks indexed access to inline styles (style[0] is undefined while
+// style.item(0) works). React sites such as Substack read style[i] and crash.
+// Defines getters for the first MAX_INDEXED_PROPS indexes.
+(function () {
+  var MAX_INDEXED_PROPS = 200;
+  var proto = CSSStyleDeclaration.prototype;
+
+  for (var i = 0; i < MAX_INDEXED_PROPS; i++) {
+    defineIndex(i);
+  }
+
+  function defineIndex(i) {
+    Object.defineProperty(proto, i, {
+      get: function () { return i < this.length ? this.item(i) : undefined; },
+      configurable: true,
+    });
+  }
+})();
diff --git a/src/browser/trafilatura.zig b/src/browser/trafilatura.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e1fc1b3c929ba8060466f348521be533124d4a80
--- /dev/null
+++ b/src/browser/trafilatura.zig
@@ -0,0 +1,125 @@
+// snitchmd: `--dump markdown` serializes the rendered DOM to HTML, then
+// extracts the main content as Markdown with rs-trafilatura (src/rust/trafilatura).
+// Lightpanda's own whole-page converter stays as `--dump markdown_full`.
+
+const std = @import("std");
+const dump = @import("dump.zig");
+const markdown = @import("markdown.zig");
+const LimitedWriter = @import("../LimitedWriter.zig");
+const RenderTree = @import("RenderTree.zig");
+const Frame = @import("Frame.zig");
+
+/// rs-trafilatura settings, plus an optional slot that receives the extraction.
+pub const Opts = struct {
+    include_images: bool = false,
+    favor_precision: bool = false,
+    favor_recall: bool = false,
+    /// snitchmd: filled for the cache, the stderr summary and `--json`.
+    result: ?*Result = null,
+};
+
+/// One page's extraction. Strings are owned by `allocator`.
+pub const Result = struct {
+    allocator: std.mem.Allocator,
+    final_url: []const u8 = "",
+    page_title: ?[]const u8 = null,
+    html: []const u8 = "",
+    markdown: []const u8 = "",
+    title: ?[]const u8 = null,
+    page_type: ?[]const u8 = null,
+    /// Null when the server sent Markdown itself.
+    quality: ?f64 = null,
+};
+
+/// Writes the page's main content as Markdown extracted by rs-trafilatura.
+pub fn render(allocator: std.mem.Allocator, state: RenderTree.State, opts: dump.Opts, extract: Opts, writer: *std.Io.Writer, frame: *Frame) !void {
+    // The server sent Markdown itself: nothing to extract.
+    if (markdown.markdownSource(state.root) != null) {
+        const result = extract.result orelse {
+            return markdown.dump(state, .{ .max_bytes = opts.max_bytes }, writer, frame);
+        };
+        var served: std.Io.Writer.Allocating = .init(result.allocator);
+        try markdown.dump(state, .{}, &served.writer, frame);
+        try fill(result, frame, "", std.mem.trim(u8, served.written(), " \t\r\n"), null, null, null);
+        return writeLimited(writer, result.markdown, opts.max_bytes);
+    }
+
+    // max_bytes caps the Markdown below, not the HTML fed to the extractor.
+    var html_opts = opts;
+    html_opts.max_bytes = null;
+
+    var html: std.Io.Writer.Allocating = .init(allocator);
+    defer html.deinit();
+    try dump.render(state, html_opts, &html.writer, frame);
+    const bytes = html.written();
+
+    const out = trafilatura_markdown(.{
+        .html_ptr = bytes.ptr,
+        .html_len = bytes.len,
+        .url_ptr = frame.url.ptr,
+        .url_len = frame.url.len,
+        .include_images = extract.include_images,
+        .favor_precision = extract.favor_precision,
+        .favor_recall = extract.favor_recall,
+    });
+    defer trafilatura_free(out);
+
+    // null: no main content, or rs-trafilatura failed (failures are logged to stderr).
+    const md = out.markdown.slice() orelse return error.ExtractionEmpty;
+
+    if (extract.result) |result| {
+        try fill(result, frame, bytes, md, out.title.slice(), out.page_type.slice(), out.quality);
+    }
+    return writeLimited(writer, md, opts.max_bytes);
+}
+
+fn fill(result: *Result, frame: *Frame, html: []const u8, md: []const u8, title: ?[]const u8, page_type: ?[]const u8, quality: ?f64) !void {
+    const a = result.allocator;
+    result.final_url = try a.dupe(u8, frame.url);
+    result.page_title = if (try frame.getTitle()) |t| try a.dupe(u8, t) else null;
+    result.html = try a.dupe(u8, html);
+    result.markdown = try a.dupe(u8, md);
+    result.title = if (title) |t| try a.dupe(u8, t) else null;
+    result.page_type = if (page_type) |t| try a.dupe(u8, t) else null;
+    result.quality = quality;
+}
+
+/// Writes `md` and a newline; past `max_bytes` it ends with the marker the other dumps use.
+pub fn writeLimited(writer: *std.Io.Writer, md: []const u8, max_bytes: ?u32) !void {
+    var limited = LimitedWriter.init(writer, max_bytes);
+    limited.writer.writeAll(md) catch |err| {
+        if (!limited.truncated) return err;
+        return writer.writeAll(LimitedWriter.truncation_marker);
+    };
+    try writer.writeByte('\n');
+}
+
+const Input = extern struct {
+    html_ptr: [*]const u8,
+    html_len: usize,
+    url_ptr: [*]const u8,
+    url_len: usize,
+    include_images: bool,
+    favor_precision: bool,
+    favor_recall: bool,
+};
+
+const Bytes = extern struct {
+    ptr: ?[*]u8,
+    len: usize,
+
+    fn slice(self: Bytes) ?[]const u8 {
+        const ptr = self.ptr orelse return null;
+        return ptr[0..self.len];
+    }
+};
+
+const Output = extern struct {
+    markdown: Bytes,
+    title: Bytes,
+    page_type: Bytes,
+    quality: f64,
+};
+
+extern "c" fn trafilatura_markdown(input: Input) Output;
+extern "c" fn trafilatura_free(out: Output) void;
