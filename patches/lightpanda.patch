diff --git a/src/browser/main_markdown.zig b/src/browser/main_markdown.zig
new file mode 100644
index 000000000..9ccf40852
--- /dev/null
+++ b/src/browser/main_markdown.zig
@@ -0,0 +1,44 @@
+// snitchmd: `--dump main_markdown` serializes the rendered DOM to HTML, then
+// extracts the main content as Markdown with rs-trafilatura (src/rust/trafilatura).
+
+const std = @import("std");
+const dump = @import("dump.zig");
+const RenderTree = @import("RenderTree.zig");
+const Frame = @import("Frame.zig");
+
+/// Writes the page's main content as Markdown extracted by rs-trafilatura.
+pub fn render(allocator: std.mem.Allocator, state: RenderTree.State, opts: dump.Opts, writer: *std.Io.Writer, frame: *Frame) !void {
+    var html: std.Io.Writer.Allocating = .init(allocator);
+    defer html.deinit();
+    try dump.render(state, opts, &html.writer, frame);
+    const bytes = html.written();
+
+    const out = trafilatura_markdown(.{
+        .html_ptr = bytes.ptr,
+        .html_len = bytes.len,
+        .url_ptr = frame.url.ptr,
+        .url_len = frame.url.len,
+    });
+    defer trafilatura_free(out);
+
+    // null: no main content, or rs-trafilatura failed (failures are logged to stderr).
+    const ptr = out.ptr orelse return error.ExtractionEmpty;
+
+    try writer.writeAll(ptr[0..out.len]);
+    try writer.writeByte('\n');
+}
+
+const Input = extern struct {
+    html_ptr: [*]const u8,
+    html_len: usize,
+    url_ptr: [*]const u8,
+    url_len: usize,
+};
+
+const Output = extern struct {
+    ptr: ?[*]u8,
+    len: usize,
+};
+
+extern "c" fn trafilatura_markdown(input: Input) Output;
+extern "c" fn trafilatura_free(out: Output) void;
